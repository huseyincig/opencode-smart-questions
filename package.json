{
  "name": "opencode-smart-questions",
  "version": "0.4.0",
  "description": "Language-neutral auto-selection of recommended OpenCode question options with user-interaction cancellation and separate V1/V2 adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "index.js",
    "server.js",
    "tui.js"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/emit-tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "smart-question",
    "auto-selection",
    "tui",
    "automation",
    "question-dialog"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-smart-questions.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-smart-questions/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-smart-questions#readme",
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode/plugin": "^2.0.22",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "1.9.12",
    "esbuild": "^0.25.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@opentui/solid": {
      "@babel/core": "^7.29.7",
      "@babel/preset-typescript": "^7.29.7"
    }
  }
}
