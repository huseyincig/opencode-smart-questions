{
  "name": "opencode-smart-questions",
  "version": "1.3.2",
  "description": "Language-neutral auto-selection of recommended OpenCode V2 question forms with user-interaction cancellation, remediation, and optional Plugin Mesh handoffs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "index.js",
    "server.js",
    "tui.js"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/emit-tui.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noUncheckedIndexedAccess --exactOptionalPropertyTypes",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:acceptance": "node tests/v2-live-acceptance.mjs",
    "test:all": "npm test && npm run test:acceptance",
    "prepack": "npm run build",
    "lint": "oxlint src tests --deny-warnings"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "opencode-plugin",
    "ai-agent",
    "smart-question",
    "auto-selection",
    "tui",
    "opentui",
    "automation",
    "question-dialog",
    "plugin-mesh",
    "handoff"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-smart-questions.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-smart-questions/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-smart-questions#readme",
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0 || ^2.4.0",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": "^1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/plugin": "^2.4.1",
    "@opentui/core": "^0.9.9",
    "@opentui/solid": "^0.9.9",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.17",
    "esbuild": "^0.25.0",
    "oxlint": "1.87.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "@opentui/solid": {
      "@babel/core": "^7.29.7",
      "@babel/preset-typescript": "^7.29.7"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
